# serve.yaml - contextmatrix-agent service configuration
#
# Copy to ~/.config/contextmatrix-agent/serve.yaml (the XDG default location)
# and edit before starting the service. Every scalar field can also be set or
# overridden with a CMX_* environment variable; list/map fields are YAML-only
# or use the nested CMX_…__KEY form (see each field below). An unknown key (a
# typo, or one a later version removed) stops startup and `config validate`
# with an error naming it; worker_extra_env entries and CMX_* variables are not
# checked.

# --- ContextMatrix connectivity -----------------------------------------------

# URL of the ContextMatrix API reachable from the agent service host.
# Used for status callbacks. Required.
# CMX_CONTEXTMATRIX_URL
contextmatrix_url: http://localhost:8080

# URL of the ContextMatrix API as seen from inside worker containers.
# Required whenever contextmatrix_url above is a loopback host: workers
# resolve CM_MCP_URL from this value, and without it they would point at
# their own localhost and fail at MCP connect. Startup refuses that
# combination rather than letting every card run die inside its container.
# The value below is the Docker bridge gateway (typically the host's Docker
# bridge address). For host-network containers or a named Docker network,
# use the service hostname or IP reachable from containers instead.
# CMX_CONTAINER_CONTEXTMATRIX_URL
container_contextmatrix_url: http://172.17.0.1:8080

# URL of this service as seen from inside worker containers: workers reach
# this service's LLM proxy at this URL. Optional. When empty it defaults to
# http://host.docker.internal:<port>, with port as set below; that works
# because workers always get host.docker.internal mapped to the host gateway.
# Must be http or https, carry no path, query or fragment, and not be a
# loopback or unspecified (0.0.0.0, ::) host. Workers must reach this URL, so
# a host firewall must allow container-to-host traffic on its port. The host
# must resolve inside the worker container: unlike the MCP hostname it is not
# pinned into the container's /etc/hosts, so use an IP or the
# host.docker.internal default if in-container DNS cannot resolve it.
# CMX_CONTAINER_SERVE_URL
container_serve_url: ""

# Shared secret between ContextMatrix and the agent service.
# Must be at least 32 characters. Required.
# CMX_API_KEY
api_key: ""

# MCP API key passed to worker containers as CM_MCP_API_KEY.
# Workers use it to authenticate against the ContextMatrix MCP server.
# CMX_MCP_API_KEY
mcp_api_key: ""

# --- Serving ------------------------------------------------------------------

# Port the agent service listens on. Default: 9092.
# CMX_PORT
port: 9092

# Admin listener serving Prometheus /metrics. 0 disables it (the default); a
# typical enabled value is 9093. Must differ from port when set.
# CMX_ADMIN_PORT
# admin_port: 0

# Address the admin listener binds to. Default 127.0.0.1 (loopback-only). Set
# a LAN address (or 0.0.0.0) to let an external Prometheus scrape /metrics;
# restrict access with a firewall when binding beyond loopback.
# CMX_ADMIN_BIND_ADDR
# admin_bind_addr: "127.0.0.1"

# Static bearer token accepted on GET /metrics as an alternative to the
# HMAC-signed request scheme, for scrapers that cannot sign requests. Use it
# as the `authorization.credentials` value in a Prometheus scrape config.
# Generate with e.g. `openssl rand -hex 32`. Empty keeps /metrics HMAC-only.
# CMX_METRICS_TOKEN
# metrics_token: ""

# Log level: debug | info | warn | error. Default: info.
# CMX_LOG_LEVEL
log_level: info

# Directory on the agent host for per-card container-output logs. When set, the
# agent writes one append file per card, <log_dir>/<project>/<card_id>.log,
# containing the raw container output (as `docker logs -f` would show it). Files
# are 0600: CM-provisioned secrets are masked; operator-supplied values
# (worker_extra_env, verify.env pass-throughs) and anything the model prints are
# not.
# Empty (the default) disables file logging. Logs are kept indefinitely; use an
# external logrotate for retention. If this path is outside /var/run/cm-agent,
# ~/.cm-agent, or ~/.contextmatrix, add it to ReadWritePaths in the systemd
# unit (see svc.sh).
# CMX_LOG_DIR
# log_dir: ~/.contextmatrix/agent/logs

# --- Worker containers --------------------------------------------------------

# Docker image launched for each card. Pin to a digest for reproducibility.
# Required.
# CMX_BASE_IMAGE
# base_image: ghcr.io/mhersson/contextmatrix-agent@sha256:<digest>

# Image pull policy: never | if-not-present | always. Default: if-not-present.
# CMX_IMAGE_PULL_POLICY
image_pull_policy: if-not-present

# Substring filters for GET /images (the ContextMatrix settings dropdown).
# An image tag is listed when it contains any of these substrings; images with
# no matching tag are omitted. Default: [contextmatrix-agent]. YAML only - the
# CMX_ env layer cannot express list values.
image_list_filters:
  - contextmatrix-agent

# Maximum number of concurrent worker containers. Default: 5.
# CMX_MAX_CONCURRENT
max_concurrent: 5

# Maximum lifetime of a worker container before the agent's own watchdog kills
# it. Must not exceed 150m (ContextMatrix force-kills containers older than
# 150m externally; the agent must fire first so cleanup happens properly).
# Relayed into the worker as CMX_CONTAINER_TIMEOUT_SECONDS so the pr_gates
# phase can park about 10 minutes ahead of the kill instead of being cut off
# mid-wait. Default: 2h30m.
# CMX_CONTAINER_TIMEOUT
container_timeout: 2h30m

# Maximum container memory in bytes. Default: 8589934592 (8 GiB).
# CMX_CONTAINER_MEMORY_LIMIT
container_memory_limit: 8589934592

# Maximum container PID count (cgroup pids limit - threads count too, so a
# parallel test suite on a many-core host needs headroom). Default: 2048.
# CMX_CONTAINER_PIDS_LIMIT
container_pids_limit: 2048

# How long a container can produce no stdout/stderr before it is considered
# idle and killed. Default: 30m.
# CMX_IDLE_OUTPUT_TIMEOUT
idle_output_timeout: 30m

# How often the idle watchdog polls for output. Default: 30s.
# CMX_IDLE_WATCHDOG_INTERVAL
idle_watchdog_interval: 30s

# Host directory holding per-run credential files, each bind-mounted read-only
# into its container at /run/cm-secrets. The agent stages the CM-provisioned
# git token and the LLM proxy's stand-in token (the real LLM key stays in this
# service's memory) into <secrets_dir>/runs/<project>/<card_id>/env and
# refreshes the git token from ContextMatrix until the run is torn down.
# Default: /var/run/cm-agent/secrets.
# CMX_SECRETS_DIR
secrets_dir: /var/run/cm-agent/secrets

# Optional host path to a PEM file of extra CA certificates (corporate TLS
# interception / Zscaler, or a private-CA GitHub Enterprise). This service's
# LLM proxy trusts it, on top of the system pool, for its upstream TLS. It is
# also bind-mounted read-only into each worker at /run/cm-ca/ca.crt and the
# worker trusts it for its OWN outbound TLS - the harness LLM client, the
# MCP/cmclient connection, and the git/gh subprocesses. It does NOT cover
# model-invoked bash tools (curl/pip/npm), whose env the harness scrubs;
# covering those needs a harness change. This service's other outbound calls
# use the OS trust store, so install the CA there separately if needed.
# serve reads the file at start-up as its own user, so an unreadable file, or
# one holding no PEM certificate, stops serve from starting.
# Empty = disabled.
# CMX_CA_CERT_FILE
# ca_cert_file: /etc/contextmatrix-agent/extra-ca.pem

# Additional environment variables injected verbatim into every worker
# container. Useful for operator-specific passthrough.
#
# Container env beats the staged secrets file, so an LLM_API_KEY or
# LLM_BASE_URL here overrides the LLM proxy values: setting both bypasses the
# proxy and puts that key in the container, and setting only one breaks the
# run (the proxy answers a real key with 401). An HTTP proxy here needs the
# serve host (host.docker.internal by default) in NO_PROXY, and does not reach
# LLM calls: those leave from this service, so its own HTTP(S)_PROXY /
# NO_PROXY environment applies (set it on the process or its service unit).
#
# CMX_READ_ONLY_ROOTS belongs here when the image's own declaration is wrong for
# your deployment. It is a colon-separated list of absolute trees the worker's
# read, grep and glob tools may resolve in addition to the workspace, so the
# shell-less planning, diagnosis, review and checkpoint phases can read
# dependency source instead of guessing at an API. Every worker image already
# declares where its own toolchain caches source; a value set here replaces that
# declaration. Writes are never widened - edit, write and bash stay inside the
# workspace - and a root that is relative, unresolvable, the filesystem root, or
# a parent of the workspace is dropped, so a mistake here narrows access, never
# widens it.
#
# worker_extra_env:
#   HTTP_PROXY: http://proxy.example.com:3128
#   NO_PROXY: localhost,127.0.0.1,host.docker.internal
#   CMX_READ_ONLY_ROOTS: /home/user/go/pkg/mod:/opt/python

# Default model slug used when a trigger does not specify a model or
# the requested model is unresolvable. Also the selector's second-choice
# capable default: when the candidate pool is empty the selector falls back
# to the trigger's default_model first, then this, then the compiled-in
# deepseek/deepseek-v4-flash. Optional.
# CMX_DEFAULT_MODEL
# default_model: deepseek/deepseek-v4-flash

# Reasoning effort for every worker phase: "" (no effort sent: each model reasons at its own default) | low | medium | high |
# provider-specific tiers (e.g. xhigh). CMX_REASONING_EFFORT
# Sent to every selected model - the endpoint must accept reasoning_effort on
# ALL served models, or leave this empty.
# Non-canonical values (anything outside low|medium|high|"") are forwarded to
# the provider as-is; the agent logs a startup warning so a typo doesn't go
# unnoticed.
# reasoning_effort: ""

# Reasoning replay: each reply's reasoning goes back with every later request of
# its harness run, so the model continues from its own thinking instead of
# working it out again. Replayed reasoning bills as input and fills the context
# window sooner, so a model whose catalog window is under 400000 tokens, or
# unknown, never replays. A mob seat's next round gets its reasoning only on the
# model that wrote it. A model whose endpoint rejects the reasoning costs one
# rejected request per turn and runs on without it. Set false to turn replay off.
# Default: true.
# CMX_REPLAY_REASONING
# replay_reasoning: true

# --- Per-card budget ----------------------------------------------------------

# Cumulative USD ceiling per card. Workers receive this as CMX_MAX_CARD_COST.
# The orchestrator enforces this ceiling and aborts the card when exceeded.
# 0 disables the ceiling. Note: koanf cannot distinguish an absent key from
# an explicit 0 - if the key is absent the default (5.0) applies; an explicit
# 0 in YAML or via env disables the ceiling.
# Default: 5.0
# CMX_MAX_CARD_COST
max_card_cost: 5.0

# --- Webhook replay protection ------------------------------------------------

# Maximum clock skew (in seconds) tolerated between ContextMatrix and the agent
# service when validating HMAC timestamps. Default: 330 (5.5 minutes).
# CMX_WEBHOOK_REPLAY_SKEW_SECONDS
webhook_replay_skew_seconds: 330

# Maximum number of recent request signatures retained for replay detection.
# Default: 10000.
# CMX_WEBHOOK_REPLAY_CACHE_SIZE
webhook_replay_cache_size: 10000

# --- Message deduplication ----------------------------------------------------

# How long a delivered message_id is retained to suppress retries. Default: 600s.
# CMX_MESSAGE_DEDUP_TTL_SECONDS
message_dedup_ttl_seconds: 600

# Maximum number of message_ids retained for deduplication. Default: 1000.
# CMX_MESSAGE_DEDUP_CACHE_SIZE
message_dedup_cache_size: 1000

# --- Worker CMX_* knobs -------------------------------------------------------

# Maximum wall-clock seconds a bash tool call may run inside a worker container.
# Default: 600.
# CMX_BASH_TIMEOUT_MAX_SECONDS
bash_timeout_max_seconds: 600

# Maximum bytes of tool output returned to the model per turn (128 KB backstop).
# Default: 131072.
# CMX_TOOL_OUTPUT_MAX_BYTES
tool_output_max_bytes: 131072

# How many review rounds a card gets before it parks in review. Valid values are
# 1-6, or 0/omitted for the default of 3; anything else is a startup error.
# Workers receive the value as CMX_REVIEW_ATTEMPTS_CAP.
#
# 6 is the ceiling because ContextMatrix caps a card's review_attempts counter
# at 7: with cap N the worker runs N-1 cheap rounds, each incrementing the
# counter once, and the authoritative pass increments twice more before parking
# - so the counter ends at N+1, and N=6 lands it exactly on 7.
#
# ContextMatrix never resets that counter, so the budget is per card, not per
# run. At cap 6 one run spends it all, but a later run on the same card still
# gets one full review round - it can approve and finish - and parks as soon as
# ContextMatrix refuses the next increment, rather than running the full
# configured budget.
#
# A cap of 1 enters the authoritative pass immediately, with no cheap rounds -
# if that strong review approves, nothing parks. It has the highest MINIMUM cost
# per card, not the most expensive overall: every card pays for a strong panel,
# with no chance of a cheap round settling it first.
# CMX_REVIEW_ATTEMPTS_CAP
# review_attempts_cap: 3

# --- Context compaction ---------------------------------------------------------

# Opt-in in-window compaction in the worker loop. When disabled (the default),
# nearing the context window emits a context_limit event and the subtask
# returns incomplete - never a silent truncation. Default: false.
# CMX_COMPACTION_ENABLED
# compaction_enabled: false

# Fraction of the context window at which compaction triggers. Must be in
# (0, 1] when compaction is enabled. Default: 0.85.
# CMX_COMPACTION_THRESHOLD
# compaction_threshold: 0.85

# Number of most-recent messages kept verbatim when compacting - messages, not
# turns, despite the key name: a tool-using turn is an assistant message plus
# one message per tool result. Must be >= 1 when compaction is enabled.
# Default: 6.
# CMX_COMPACTION_KEEP_RECENT_TURNS
# compaction_keep_recent_turns: 6

# --- PR gates -------------------------------------------------------------------

# The pr_gates phase (between integrate and done) polls a PR's Copilot review
# and CI status when the card requests them. Serve relays each knob to the
# worker as the CMX_GATES_* variable of the same name; every value must be a
# positive integer. A CMX_GATES_* entry in worker_extra_env is still honoured
# for now, with a startup warning naming the key to use instead; when the serve
# key is also set, the serve key wins.

# Under fine-grained PAT auth the CI gate automatically polls the Actions
# runs API instead of the Checks API (which GitHub grants to Apps only);
# the PAT needs Actions: read and Commit statuses: read.

# How often the gate re-polls CI checks and the Copilot review. Default: 60.
# CMX_GATES_POLL_INTERVAL_SECONDS
# gates_poll_interval_seconds: 60

# How long the CI gate waits for checks to settle before parking. A value
# below roughly 300 (the fix-round reserve a coder run, its push, and a fresh
# CI cycle need) means the gate parks on the first red poll instead of ever
# attempting a fix round. Default: 2700.
# CMX_GATES_CI_WAIT_TIMEOUT_SECONDS
# gates_ci_wait_timeout_seconds: 2700

# How long the Copilot gate waits for a review to land before proceeding
# without one - it never parks on this timeout. Default: 1200.
# CMX_GATES_COPILOT_WAIT_TIMEOUT_SECONDS
# gates_copilot_wait_timeout_seconds: 1200

# Whether the Copilot gate posts its triage verdicts back to the PR's review
# threads (a reply per triaged comment; dismissed threads resolved at once,
# fixed ones once a re-review confirms). Best-effort - a write failure is a
# card note, never a park. Default: true.
# CMX_GATES_COPILOT_THREAD_REPLIES
# gates_copilot_thread_replies: true
