# syntax=docker/dockerfile:1.27

# Pinned toolchain versions, declared once as global ARGs and re-declared in the
# stages that consume them. Override any of them at build time with --build-arg
# when a newer release has been vetted; the Makefile passes matching values.
ARG GO_VERSION=1.27.3
ARG GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
ARG NODE_VERSION=26.12.1
ARG NODE_SHA256_AMD64=0fd1eb7770598f52a21995edf6ed35fc690400fa437c2386af329519e9143132
ARG NODE_SHA256_ARM64=a6c01af459dd8972ab3fb08ee5da81244d26ba8c4944a62d5bbba8c597ae154f
ARG NODE_LTS_VERSION=24.22.1
ARG NODE_LTS_SHA256_AMD64=eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c
ARG NODE_LTS_SHA256_ARM64=33c37be234ba8bee041961047b19160f4d7d0f164e8e246f78bdd10feff148b3
ARG NPM_VERSION=12.2.1
ARG GOLANGCI_LINT_VERSION=v2.14.0
ARG GOFUMPT_VERSION=v0.12.0
ARG RUST_VERSION=1.99.0
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256_AMD64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_SHA256_ARM64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
ARG PYTHON_VERSION=3.14.9
ARG PIP_VERSION=26.2.2
ARG TY_VERSION=0.0.84
ARG RUFF_VERSION=0.16.10
ARG YARN_VERSION=1.22.22
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
# Dependabot cannot track these release downloads (GitHub releases and
# nodejs.org): bump each version and its checksums by hand. Take Node's from the
# release's SHASUMS256.txt and gh's from its checksums file.
ARG YQ_VERSION=4.54.1
ARG YQ_SHA256_AMD64=8e34fc298390875de416e6a4afcb8cabeceb25d9aa8506c1a2f9353cf702ea5f
ARG YQ_SHA256_ARM64=189088da0c6429ec5178dfaab1a114805f6cab0b61b165ab236efedf1d57a71b
ARG TASK_VERSION=3.54.0
ARG TASK_SHA256_AMD64=680859dbb4d881a9c72d4d9a8f510825450849af8567deacd7302c01124416fb
ARG TASK_SHA256_ARM64=d7189d439d4a6058e39e1b2acd7c8b27acd4856691b408f23b242e4294e1df5b
ARG GH_VERSION=2.103.2
ARG GH_SHA256_AMD64=62ccf747115ddc61237efffdde66a3c8f70ba249433dc64f70801089b59c59c8
ARG GH_SHA256_ARM64=4c3e99a50bd8b181a3fe9d69b25dd978bac768148d88f01507c6b4d1ef61a443

# ---------------------------------------------------------------------------
# build - compile the agent binary.
# ---------------------------------------------------------------------------
FROM golang:1.27.3-trixie@sha256:604106102d33b1084e37ca08adf98ac0813624ae8595bd0d7f3965ecebded09c AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/contextmatrix-agent ./cmd/contextmatrix-agent

# ---------------------------------------------------------------------------
# uv - source image for the uv/uvx binaries copied into the Python toolchain.
# Pinned to the tag's multi-arch index digest like the debian base below;
# refresh intentionally via
#   docker buildx imagetools inspect ghcr.io/astral-sh/uv:<version>
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

# ---------------------------------------------------------------------------
# base - the shared runtime layer: apt baseline CLIs + yq, Task and the GitHub CLI.
# Every worker variant builds on this; Node and the language toolchains layer on
# top.
# ---------------------------------------------------------------------------
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS base
# ^ multi-arch index digest; the tag lets dependabot track trixie-slim.
#   Refresh intentionally via
#   `docker buildx imagetools inspect debian:trixie-slim`.

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH="/usr/local/go/bin:/home/user/go/bin:/home/user/.local/bin:${PATH}"

# The upgrade applies Debian security fixes published after the pinned base
# digest was cut, so the image does not wait on an upstream base rebuild.
# kubectl and kustomize come from Debian too and lag upstream: they render and
# validate manifests, but a cluster more than one minor newer is outside
# kubectl's version-skew policy.
# hadolint ignore=DL3008
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
      bash ca-certificates build-essential curl git jq \
      libgcc-s1 libstdc++6 openssh-client ripgrep fd-find \
      shellcheck shfmt kubectl kustomize unzip zip \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# yq (mikefarah's, not Debian's Python wrapper of the same name), Task and gh
# have no usable Debian package, so all three come from pinned upstream
# releases, SHA256-verified like the Go tarball. Only the task and gh binaries
# leave their tarballs.
ARG YQ_VERSION
ARG YQ_SHA256_AMD64
ARG YQ_SHA256_ARM64
ARG TASK_VERSION
ARG TASK_SHA256_AMD64
ARG TASK_SHA256_ARM64
ARG GH_VERSION
ARG GH_SHA256_AMD64
ARG GH_SHA256_ARM64
RUN set -eux; \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
    case "$ARCH" in \
      amd64) YQ_SHA256="${YQ_SHA256_AMD64}"; TASK_SHA256="${TASK_SHA256_AMD64}"; GH_SHA256="${GH_SHA256_AMD64}" ;; \
      arm64) YQ_SHA256="${YQ_SHA256_ARM64}"; TASK_SHA256="${TASK_SHA256_ARM64}"; GH_SHA256="${GH_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${ARCH}" -o /tmp/yq; \
    echo "${YQ_SHA256}  /tmp/yq" | sha256sum -c -; \
    install -m 0755 /tmp/yq /usr/local/bin/yq; \
    TARBALL="task_linux_${ARCH}.tar.gz"; \
    curl -fsSL "https://github.com/go-task/task/releases/download/v${TASK_VERSION}/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${TASK_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    tar -C /usr/local/bin --no-same-owner -xzf "/tmp/${TARBALL}" task; \
    GH_TARBALL="gh_${GH_VERSION}_linux_${ARCH}.tar.gz"; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${GH_TARBALL}" -o "/tmp/${GH_TARBALL}"; \
    echo "${GH_SHA256}  /tmp/${GH_TARBALL}" | sha256sum -c -; \
    tar -C /usr/local/bin --no-same-owner --strip-components=2 -xzf "/tmp/${GH_TARBALL}" "gh_${GH_VERSION}_linux_${ARCH}/bin/gh"; \
    rm -f /tmp/yq "/tmp/${TARBALL}" "/tmp/${GH_TARBALL}"

# ---------------------------------------------------------------------------
# node - base + Node.js 26. Shared by the go-node, python, and full variants.
# ---------------------------------------------------------------------------
FROM base AS node
# SHELL is re-declared per stage: hadolint (DL4006) does not track the base
# stage's pipefail shell across FROM boundaries even though Docker inherits it.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NODE_VERSION
ARG NODE_SHA256_AMD64
ARG NODE_SHA256_ARM64
ARG NPM_VERSION
# Node 26 from the official nodejs.org tarball, SHA256-verified before
# extraction like the Go tarball; no third-party apt repo. npm is then raised to
# a pinned release so its bundled dependencies are not left at whatever the
# tarball shipped. Residual CVEs the pinned npm still bundles are suppressed
# with rationale in .trivyignore.
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) NODE_ARCH=x64; NODE_SHA256="${NODE_SHA256_AMD64}" ;; \
      aarch64) NODE_ARCH=arm64; NODE_SHA256="${NODE_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    TARBALL="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${NODE_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    tar -C /usr/local --strip-components=1 --no-same-owner -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}"; \
    npm install -g "npm@${NPM_VERSION}"; \
    npm cache clean --force; \
    rm -rf /root/.npm /tmp/node-compile-cache

# ---------------------------------------------------------------------------
# go-node-toolchain - node + the Go toolchain, golangci-lint, and gofumpt.
# This is the historical worker image content.
# ---------------------------------------------------------------------------
FROM node AS go-node-toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG GO_VERSION
ARG GO_SHA256_AMD64
ARG GO_SHA256_ARM64
ARG GOLANGCI_LINT_VERSION
ARG GOFUMPT_VERSION

# Install Go. The tarball is SHA256-verified before extraction so a
# compromised CDN or MITM cannot substitute a malicious toolchain.
RUN set -eux; \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
    case "$ARCH" in \
      amd64) GO_SHA256="${GO_SHA256_AMD64}" ;; \
      arm64) GO_SHA256="${GO_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    TARBALL="go${GO_VERSION}.linux-${ARCH}.tar.gz"; \
    curl -fsSL "https://go.dev/dl/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${GO_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    tar -C /usr/local -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}"

# Install golangci-lint from source so it is compiled against the pinned Go
# toolchain. Running go clean -cache -modcache drops the ~650MB build cache and
# the ~350MB shared module cache in the same layer.
RUN CGO_ENABLED=0 GOBIN=/usr/local/bin go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    && go clean -cache -modcache

# Install gofumpt from source - same approach, compiled against the pinned Go
# toolchain.
RUN CGO_ENABLED=0 GOBIN=/usr/local/bin go install "mvdan.cc/gofumpt@${GOFUMPT_VERSION}" \
    && go clean -cache -modcache

# ---------------------------------------------------------------------------
# rust-toolchain - base + Rust via rustup (minimal profile + clippy + rustfmt).
# No Node: a pure-Rust project does not need it; use the full image otherwise.
# ---------------------------------------------------------------------------
FROM base AS rust-toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_SHA256_AMD64
ARG RUSTUP_SHA256_ARM64

ENV RUSTUP_HOME=/home/user/.rustup \
    CARGO_HOME=/home/user/.cargo
ENV PATH="/home/user/.cargo/bin:${PATH}"

# Install Rust. rustup-init is SHA256-verified before execution, mirroring the
# Go tarball check above. --profile minimal keeps the footprint down; clippy and
# rustfmt are added explicitly.
#
# The toolchain lives in the runtime user's home because that is the only place
# the rustup proxies look. Subprocesses the model runs get an environment
# scrubbed to a small allowlist (see docs/custom-images.md for the full list),
# so RUSTUP_HOME/CARGO_HOME set here never reach the model's shell and the
# proxies resolve the toolchain from their own defaults, $HOME/.rustup and
# $HOME/.cargo. /home/user is created and handed to UID 1000 up front: the
# useradd -m in the rust variant below finds the directory already present and
# leaves its ownership alone. RUSTUP_HOME/CARGO_HOME are then made
# world-writable so UID 1000 can populate the cargo registry cache - the
# official rust image uses the same pattern.
RUN set -eux; \
    mkdir -p /home/user; \
    chown 1000:1000 /home/user; \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
    case "$ARCH" in \
      amd64) RUSTUP_SHA256="${RUSTUP_SHA256_AMD64}"; RUST_ARCH="x86_64-unknown-linux-gnu" ;; \
      arm64) RUSTUP_SHA256="${RUSTUP_SHA256_ARM64}"; RUST_ARCH="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_ARCH}/rustup-init" -o /tmp/rustup-init; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" --component clippy --component rustfmt; \
    rm -f /tmp/rustup-init; \
    chmod -R a+w "${RUSTUP_HOME}" "${CARGO_HOME}"

# ---------------------------------------------------------------------------
# python-toolchain - node + uv + a managed CPython + ty + ruff.
# ---------------------------------------------------------------------------
FROM node AS python-toolchain
ARG PYTHON_VERSION
ARG PIP_VERSION
ARG TY_VERSION
ARG RUFF_VERSION

COPY --from=uv /uv /uvx /usr/local/bin/

# Managed CPython via uv. UV_PYTHON_INSTALL_DIR points the download at a
# root-owned prefix for the pinned version only; it is deliberately NOT persisted
# as ENV so that at runtime uv installs any alternate version into the user's
# writable home instead of failing on this root-owned directory. UV_NO_CACHE
# keeps the download cache out of the layer. The pip this CPython build bundles
# is replaced with PIP_VERSION so pip's vendored certifi CA bundle stays current;
# uv marks the install externally managed, hence --break-system-packages.
RUN set -eux; \
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_NO_CACHE=1; \
    uv python install "${PYTHON_VERSION}"; \
    PYBIN="$(uv python find "${PYTHON_VERSION}")"; \
    uv pip install --python "${PYBIN}" --break-system-packages "pip==${PIP_VERSION}"; \
    ln -s "${PYBIN}" /usr/local/bin/python3; \
    ln -s "${PYBIN}" /usr/local/bin/python

# ty and ruff installed as uv tools into a shared prefix with launcher shims on
# PATH. One layer for both; a version bump here never invalidates the CPython
# layer above.
RUN set -eux; \
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_NO_CACHE=1; \
    uv tool install --python "${PYTHON_VERSION}" "ty==${TY_VERSION}"; \
    uv tool install --python "${PYTHON_VERSION}" "ruff==${RUFF_VERSION}"

# ---------------------------------------------------------------------------
# jvm-node-toolchain - base + JDK 21 + Maven + Node.js 24 + yarn, for Kotlin/Java
# projects with a Node frontend. Node 24 needs its own stage because a stage
# builds once per build, so the node stage cannot also be built at 24.
# ---------------------------------------------------------------------------
FROM base AS jvm-node-toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NODE_LTS_VERSION
ARG NODE_LTS_SHA256_AMD64
ARG NODE_LTS_SHA256_ARM64
ARG NPM_VERSION
ARG YARN_VERSION
ARG MAVEN_VERSION
ARG MAVEN_SHA512

# Same approach as the node stage, at the Node 24 LTS line. The pinned npm
# supports Node 24. Yarn classic is the global yarn because it defers to a
# repository's committed Yarn Berry release (yarnPath) with no runtime
# download, where corepack would fetch the packageManager version from the
# registry on first use.
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) NODE_ARCH=x64; NODE_SHA256="${NODE_LTS_SHA256_AMD64}" ;; \
      aarch64) NODE_ARCH=arm64; NODE_SHA256="${NODE_LTS_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    TARBALL="node-v${NODE_LTS_VERSION}-linux-${NODE_ARCH}.tar.gz"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_LTS_VERSION}/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${NODE_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    tar -C /usr/local --strip-components=1 --no-same-owner -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}"; \
    npm install -g "npm@${NPM_VERSION}" "yarn@${YARN_VERSION}"; \
    npm cache clean --force; \
    rm -rf /root/.npm /tmp/node-compile-cache

# JDK 21 from Debian main; /usr/bin/java resolves through alternatives, so no
# JAVA_HOME is needed. The postinst fails on slim images without the man1 dir.
# The version check fails the build if a different JDK became the default.
# hadolint ignore=DL3008
RUN mkdir -p /usr/share/man/man1 \
    && apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && java -version 2>&1 | grep -q 'version "21\.'

# Maven from the upstream binary tarball, SHA512-verified like the Go tarball.
# Debian's package pulls in dozens of library packages and lags upstream. The
# mvn script resolves its own home through the /usr/local/bin symlink, so no
# MAVEN_HOME is needed. Gradle projects use their committed wrapper instead.
RUN set -eux; \
    TARBALL="apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${MAVEN_SHA512}  /tmp/${TARBALL}" | sha512sum -c -; \
    mkdir -p /opt/maven; \
    tar -C /opt/maven --strip-components=1 -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}"; \
    ln -s /opt/maven/bin/mvn /usr/local/bin/mvn

# ---------------------------------------------------------------------------
# Read-only roots. Each final stage declares in CMX_READ_ONLY_ROOTS the absolute
# trees where ITS OWN toolchain keeps dependency source. The agent reads the list
# once at worker start and widens the read, grep and glob tools of every phase to
# those trees, so the shell-less planning, diagnosis, review and checkpoint
# phases can read dependency source instead of guessing at an API; edit, write
# and bash stay confined to the workspace. These are image facts, which is why
# they live here rather than in the agent's source, and an operator replaces the
# list per deployment through worker_extra_env. A stage that declares nothing
# behaves exactly as before.
#
# A declared directory must exist when the worker starts or it is dropped as
# unresolvable, so caches the run populates later are created empty first. Every
# path is under the runtime user's home unless the toolchain honours a prefix
# variable at runtime: the harness scrubs the environment of subprocesses it
# runs for the model to a small allowlist (see docs/custom-images.md for the
# full list), so a toolchain pointed elsewhere by a build-time ENV falls back
# to its own default. Node needs no entry: node_modules lives inside the
# workspace.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# go-node - the Go + Node worker variant (historical image content).
# ---------------------------------------------------------------------------
FROM go-node-toolchain AS go-node
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# GOPATH is unset, so the module cache resolves to $HOME/go/pkg/mod.
ENV CMX_READ_ONLY_ROOTS=/home/user/go/pkg/mod
RUN mkdir -p /home/user/workspace /home/user/go/pkg/mod
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# rust - the Rust worker variant.
# ---------------------------------------------------------------------------
FROM rust-toolchain AS rust
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# CARGO_HOME is not on the harness subprocess allowlist, so cargo falls back to
# its default: crate sources land in $HOME/.cargo/registry and git dependencies
# in $HOME/.cargo/git.
ENV CMX_READ_ONLY_ROOTS=/home/user/.cargo/registry:/home/user/.cargo/git
RUN mkdir -p /home/user/workspace /home/user/.cargo/registry /home/user/.cargo/git
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# python - the Python worker variant.
# ---------------------------------------------------------------------------
FROM python-toolchain AS python
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# The managed CPython install prefix, holding the standard library source. A
# project's own dependencies live in its in-workspace virtualenv.
ENV CMX_READ_ONLY_ROOTS=/opt/python
RUN mkdir -p /home/user/workspace
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# jvm-node - the Kotlin/Java + Node worker variant.
# ---------------------------------------------------------------------------
FROM jvm-node-toolchain AS jvm-node
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# No read-only roots: the Gradle and Maven caches hold jars the read tools
# cannot open, plus POMs that carry no API.
RUN mkdir -p /home/user/workspace
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# full - every toolchain (Go, Node, Rust, Python). The DEFAULT target: this is
# what `make docker-worker` builds and what the :dev / :latest tags point at.
#
# Built FROM python-toolchain so the managed CPython, its /usr/local/bin symlinks
# and the uv tool shims stay intact (an explicit-source COPY would dereference
# them). Go is a self-contained prefix and copies in cleanly. Rust lands in the
# runtime user's home, where the rustup proxies resolve it by default: the
# environment of the subprocesses the model runs is scrubbed down to a small
# allowlist that carries no RUSTUP_HOME/CARGO_HOME, so a build-time prefix
# variable would never reach the model's shell. --chmod on the Rust copy
# re-applies the world-writable bits (COPY --from drops them) in the same layer,
# so UID 1000 can populate the cargo registry cache without a second ~1 GB chmod
# layer. Whether that --chmod also reaches the copied trees' own top directories,
# and the /home/user they imply, varies between BuildKit releases, so nothing
# here leans on it: the home, both toolchain roots and every cache directory are
# created and handed to UID 1000 explicitly, as root, below.
# ---------------------------------------------------------------------------
FROM python-toolchain AS full

# Go toolchain (self-contained prefix + static binaries; read-only at runtime).
COPY --from=go-node-toolchain /usr/local/go /usr/local/go
COPY --from=go-node-toolchain /usr/local/bin/golangci-lint /usr/local/bin/gofumpt /usr/local/bin/

# Rust toolchain.
ENV RUSTUP_HOME=/home/user/.rustup \
    CARGO_HOME=/home/user/.cargo
ENV PATH="/home/user/.cargo/bin:${PATH}"
COPY --chmod=0777 --from=rust-toolchain /home/user/.rustup /home/user/.rustup
COPY --chmod=0777 --from=rust-toolchain /home/user/.cargo /home/user/.cargo

COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
# The runtime home is laid out in one root step: the caches the read-only roots
# name must exist before the worker starts, and UID 1000 has to write into them
# and into CARGO_HOME itself, where cargo takes its package-cache lock. The
# toolchain roots are chowned and chmodded non-recursively, so their contents
# keep the mode the copies gave them and no second pass over ~1 GB is added.
RUN useradd -m -u 1000 -s /bin/bash user \
    && mkdir -p /home/user/workspace /home/user/go/pkg/mod \
         /home/user/.cargo/registry /home/user/.cargo/git \
    && chown -R 1000:1000 /home/user/workspace /home/user/go \
    && chown 1000:1000 /home/user /home/user/.rustup /home/user/.cargo \
         /home/user/.cargo/registry /home/user/.cargo/git \
    && chmod 0755 /home/user /home/user/.rustup /home/user/.cargo
USER 1000:1000
WORKDIR /home/user
# Every toolchain's own roots, joined: Go, Rust, Python.
ENV CMX_READ_ONLY_ROOTS=/home/user/go/pkg/mod:/home/user/.cargo/registry:/home/user/.cargo/git:/opt/python
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]
