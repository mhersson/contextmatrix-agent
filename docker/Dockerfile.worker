# syntax=docker/dockerfile:1.7

# Pinned toolchain versions, declared once as global ARGs and re-declared in the
# stages that consume them. Override any of them at build time with --build-arg
# when a newer release has been vetted; the Makefile passes matching values.
ARG GO_VERSION=1.26.7
ARG GO_SHA256_AMD64=ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca
ARG GO_SHA256_ARM64=5a4ec883379d51ee9ce1040d5e87f8d35e20387574dd8c947feb01eabc3c1b37
ARG NPM_VERSION=11.19.0
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GOFUMPT_VERSION=v0.11.0
ARG RUST_VERSION=1.97.0
ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_SHA256_AMD64=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
ARG RUSTUP_SHA256_ARM64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
ARG PYTHON_VERSION=3.14.6
ARG TY_VERSION=0.0.57
ARG RUFF_VERSION=0.15.21

# ---------------------------------------------------------------------------
# build - compile the agent binary.
# ---------------------------------------------------------------------------
FROM golang:1.26.7-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/contextmatrix-agent ./cmd/contextmatrix-agent

# ---------------------------------------------------------------------------
# uv - source image for the uv/uvx binaries copied into the Python toolchain.
# Digest-pinned like the debian base below; refresh intentionally via
#   docker buildx imagetools inspect ghcr.io/astral-sh/uv:<version>
# uv 0.11.29 multi-arch index digest resolved 2026-07-16.
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 AS uv

# ---------------------------------------------------------------------------
# base - the shared runtime layer: apt baseline CLIs + GitHub CLI. Every worker
# variant builds on this; Node and the language toolchains layer on top.
# ---------------------------------------------------------------------------
FROM debian@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS base
# ^ debian:bookworm-slim resolved on 2026-08-03. Refresh intentionally via
#   `docker pull debian:bookworm-slim && docker inspect --format='{{index .RepoDigests 0}}' debian:bookworm-slim`.

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH="/usr/local/go/bin:/home/user/go/bin:/home/user/.local/bin:${PATH}"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates build-essential curl git jq \
      libgcc-s1 libstdc++6 openssh-client ripgrep fd-find \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# github-cli isn't in Debian's main repo - install from GitHub's apt source.
# hadolint ignore=DL3008
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# node - base + Node.js 25. Shared by the go-node, python, and full variants.
# ---------------------------------------------------------------------------
FROM base AS node
# SHELL is re-declared per stage: hadolint (DL4006) does not track the base
# stage's pipefail shell across FROM boundaries even though Docker inherits it.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG NPM_VERSION
# Node 25. NodeSource's setup_25.x script adds a signed apt repo. npm is then
# raised to a pinned release: the nodesource bundle ships npm with a
# vulnerable bundled tar, and npm 12 does not support Node 25, so the 11 line
# is the ceiling. The residual CVEs npm 11 still bundles are suppressed with
# rationale in .trivyignore.
# hadolint ignore=DL3008
RUN curl -fsSL https://deb.nodesource.com/setup_25.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "npm@${NPM_VERSION}" \
    && npm cache clean --force \
    && rm -rf /root/.npm

# ---------------------------------------------------------------------------
# go-node-toolchain - node + the Go toolchain, golangci-lint, and gofumpt.
# This is the historical worker image content.
# ---------------------------------------------------------------------------
FROM node AS go-node-toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG GO_VERSION
ARG GO_SHA256_AMD64
ARG GO_SHA256_ARM64
ARG GOLANGCI_LINT_VERSION
ARG GOFUMPT_VERSION

# Install Go. The tarball is SHA256-verified before extraction so a
# compromised CDN or MITM cannot substitute a malicious toolchain.
RUN set -eux; \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
    case "$ARCH" in \
      amd64) GO_SHA256="${GO_SHA256_AMD64}" ;; \
      arm64) GO_SHA256="${GO_SHA256_ARM64}" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    TARBALL="go${GO_VERSION}.linux-${ARCH}.tar.gz"; \
    curl -fsSL "https://go.dev/dl/${TARBALL}" -o "/tmp/${TARBALL}"; \
    echo "${GO_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    tar -C /usr/local -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}"

# Install golangci-lint from source so it is compiled against the pinned Go
# toolchain. Running go clean -modcache drops the ~350MB shared module cache
# in the same layer.
RUN CGO_ENABLED=0 GOBIN=/usr/local/bin go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    && go clean -modcache

# Install gofumpt from source - same approach, compiled against the pinned Go
# toolchain.
RUN CGO_ENABLED=0 GOBIN=/usr/local/bin go install "mvdan.cc/gofumpt@${GOFUMPT_VERSION}" \
    && go clean -modcache

# ---------------------------------------------------------------------------
# rust-toolchain - base + Rust via rustup (minimal profile + clippy + rustfmt).
# No Node: a pure-Rust project does not need it; use the full image otherwise.
# ---------------------------------------------------------------------------
FROM base AS rust-toolchain
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG RUST_VERSION
ARG RUSTUP_VERSION
ARG RUSTUP_SHA256_AMD64
ARG RUSTUP_SHA256_ARM64

ENV RUSTUP_HOME=/home/user/.rustup \
    CARGO_HOME=/home/user/.cargo
ENV PATH="/home/user/.cargo/bin:${PATH}"

# Install Rust. rustup-init is SHA256-verified before execution, mirroring the
# Go tarball check above. --profile minimal keeps the footprint down; clippy and
# rustfmt are added explicitly.
#
# The toolchain lives in the runtime user's home because that is the only place
# the rustup proxies look. Subprocesses the model runs get an environment
# scrubbed down to a small allowlist (PATH, HOME, USER, LANG, LC_ALL, TMPDIR,
# TERM), so RUSTUP_HOME/CARGO_HOME set here never reach the model's shell and
# the proxies resolve the toolchain from their own defaults, $HOME/.rustup and
# $HOME/.cargo. /home/user is created and handed to UID 1000 up front: the
# useradd -m in the rust variant below finds the directory already present and
# leaves its ownership alone. RUSTUP_HOME/CARGO_HOME are then made
# world-writable so UID 1000 can populate the cargo registry cache - the
# official rust image uses the same pattern.
RUN set -eux; \
    mkdir -p /home/user; \
    chown 1000:1000 /home/user; \
    ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
    case "$ARCH" in \
      amd64) RUSTUP_SHA256="${RUSTUP_SHA256_AMD64}"; RUST_ARCH="x86_64-unknown-linux-gnu" ;; \
      arm64) RUSTUP_SHA256="${RUSTUP_SHA256_ARM64}"; RUST_ARCH="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUST_ARCH}/rustup-init" -o /tmp/rustup-init; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" --component clippy --component rustfmt; \
    rm -f /tmp/rustup-init; \
    chmod -R a+w "${RUSTUP_HOME}" "${CARGO_HOME}"

# ---------------------------------------------------------------------------
# python-toolchain - node + uv + a managed CPython + ty + ruff.
# ---------------------------------------------------------------------------
FROM node AS python-toolchain
ARG PYTHON_VERSION
ARG TY_VERSION
ARG RUFF_VERSION

COPY --from=uv /uv /uvx /usr/local/bin/

# Managed CPython via uv. UV_PYTHON_INSTALL_DIR points the download at a
# root-owned prefix for the pinned version only; it is deliberately NOT persisted
# as ENV so that at runtime uv installs any alternate version into the user's
# writable home instead of failing on this root-owned directory.
RUN set -eux; \
    export UV_PYTHON_INSTALL_DIR=/opt/python; \
    uv python install "${PYTHON_VERSION}"; \
    PYBIN="$(uv python find "${PYTHON_VERSION}")"; \
    ln -s "${PYBIN}" /usr/local/bin/python3; \
    ln -s "${PYBIN}" /usr/local/bin/python

# ty and ruff installed as uv tools into a shared prefix with launcher shims on
# PATH. One layer for both; a version bump here never invalidates the CPython
# layer above.
RUN set -eux; \
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin; \
    uv tool install --python "${PYTHON_VERSION}" "ty==${TY_VERSION}"; \
    uv tool install --python "${PYTHON_VERSION}" "ruff==${RUFF_VERSION}"

# ---------------------------------------------------------------------------
# Read-only roots. Each final stage declares in CMX_READ_ONLY_ROOTS the absolute
# trees where ITS OWN toolchain keeps dependency source. The agent reads the list
# once at worker start and widens the read, grep and glob tools of every phase to
# those trees, so the shell-less planning, diagnosis, review and checkpoint
# phases can read dependency source instead of guessing at an API; edit, write
# and bash stay confined to the workspace. These are image facts, which is why
# they live here rather than in the agent's source, and an operator replaces the
# list per deployment through worker_extra_env. A stage that declares nothing
# behaves exactly as before.
#
# A declared directory must exist when the worker starts or it is dropped as
# unresolvable, so caches the run populates later are created empty first. Every
# path is under the runtime user's home unless the toolchain honours a prefix
# variable at runtime: the harness scrubs the environment of subprocesses it runs
# for the model down to PATH, HOME, USER, LANG, LC_ALL, TMPDIR and TERM, so a
# toolchain pointed elsewhere by a build-time ENV falls back to its own default.
# Node needs no entry: node_modules lives inside the workspace.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# go-node - the Go + Node worker variant (historical image content).
# ---------------------------------------------------------------------------
FROM go-node-toolchain AS go-node
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# GOPATH is unset, so the module cache resolves to $HOME/go/pkg/mod.
ENV CMX_READ_ONLY_ROOTS=/home/user/go/pkg/mod
RUN mkdir -p /home/user/workspace /home/user/go/pkg/mod
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# rust - the Rust worker variant.
# ---------------------------------------------------------------------------
FROM rust-toolchain AS rust
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# CARGO_HOME is not on the harness subprocess allowlist, so cargo falls back to
# its default: crate sources land in $HOME/.cargo/registry and git dependencies
# in $HOME/.cargo/git.
ENV CMX_READ_ONLY_ROOTS=/home/user/.cargo/registry:/home/user/.cargo/git
RUN mkdir -p /home/user/workspace /home/user/.cargo/registry /home/user/.cargo/git
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# python - the Python worker variant.
# ---------------------------------------------------------------------------
FROM python-toolchain AS python
COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
RUN useradd -m -u 1000 -s /bin/bash user
USER 1000:1000
WORKDIR /home/user
# The managed CPython install prefix, holding the standard library source. A
# project's own dependencies live in its in-workspace virtualenv.
ENV CMX_READ_ONLY_ROOTS=/opt/python
RUN mkdir -p /home/user/workspace
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]

# ---------------------------------------------------------------------------
# full - every toolchain (Go, Node, Rust, Python). The DEFAULT target: this is
# what `make docker-worker` builds and what the :dev / :latest tags point at.
#
# Built FROM python-toolchain so the managed CPython, its /usr/local/bin symlinks
# and the uv tool shims stay intact (an explicit-source COPY would dereference
# them). Go is a self-contained prefix and copies in cleanly. Rust lands in the
# runtime user's home, where the rustup proxies resolve it by default: the
# environment of the subprocesses the model runs is scrubbed down to a small
# allowlist that carries no RUSTUP_HOME/CARGO_HOME, so a build-time prefix
# variable would never reach the model's shell. --chmod on the Rust copy
# re-applies the world-writable bits (COPY --from drops them) in the same layer,
# so UID 1000 can populate the cargo registry cache without a second ~1 GB chmod
# layer. That copy also creates /home/user as an implicit parent and applies the
# same mode to it, which leaves useradd -m nothing to create and so nothing to
# own; the home is set explicitly below instead, as root, so this variant's
# runtime user gets the same home ownership and mode as the single-toolchain
# ones.
# ---------------------------------------------------------------------------
FROM python-toolchain AS full

# Go toolchain (self-contained prefix + static binaries; read-only at runtime).
COPY --from=go-node-toolchain /usr/local/go /usr/local/go
COPY --from=go-node-toolchain /usr/local/bin/golangci-lint /usr/local/bin/gofumpt /usr/local/bin/

# Rust toolchain.
ENV RUSTUP_HOME=/home/user/.rustup \
    CARGO_HOME=/home/user/.cargo
ENV PATH="/home/user/.cargo/bin:${PATH}"
COPY --chmod=0777 --from=rust-toolchain /home/user/.rustup /home/user/.rustup
COPY --chmod=0777 --from=rust-toolchain /home/user/.cargo /home/user/.cargo

COPY --from=build /out/contextmatrix-agent /usr/local/bin/contextmatrix-agent
# The home is chowned here rather than in the mkdir below, which runs as UID
# 1000 and cannot. Not recursive: the Rust trees under it stay world-writable so
# the cargo cache is still populatable at runtime.
RUN useradd -m -u 1000 -s /bin/bash user \
    && chown 1000:1000 /home/user \
    && chmod 0755 /home/user
USER 1000:1000
WORKDIR /home/user
# Every toolchain's own roots, joined: Go, Rust, Python.
ENV CMX_READ_ONLY_ROOTS=/home/user/go/pkg/mod:/home/user/.cargo/registry:/home/user/.cargo/git:/opt/python
RUN mkdir -p /home/user/workspace /home/user/go/pkg/mod \
      /home/user/.cargo/registry /home/user/.cargo/git
HEALTHCHECK NONE
ENTRYPOINT ["contextmatrix-agent", "work"]
